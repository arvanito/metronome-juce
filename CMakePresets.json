{
  "version": 3,
  "configurePresets": [
    {
      "name": "windows",
      "displayName": "Windows (Ninja, MSVC)",
      "description": "Build output lives in %USERPROFILE%/.builds, outside OneDrive (so it is not synced) and outside AppData (which Windows redirects for packaged apps).",
      "generator": "Ninja Multi-Config",
      "binaryDir": "$env{USERPROFILE}/.builds/metronome-juce/build",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "FETCHCONTENT_BASE_DIR": "$env{USERPROFILE}/.builds/metronome-juce/deps"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "windows", "configuration": "Debug" },
    { "name": "release", "configurePreset": "windows", "configuration": "Release" }
  ],
  "testPresets": [
    { "name": "debug", "configurePreset": "windows", "configuration": "Debug", "output": { "outputOnFailure": true } }
  ]
}
